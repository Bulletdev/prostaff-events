# prostaff-events environment variables

# Redis URL — same Redis instance shared with prostaff-api
REDIS_URL=redis://localhost:6379/0

# MUST match INTERNAL_JWT_SECRET in prostaff-api
INTERNAL_JWT_SECRET=

# Phoenix secret key base (generate with: mix phx.gen.secret)
SECRET_KEY_BASE=

# prostaff-api base URL (for startup reconciliation of InhouseQueues)
RAILS_API_URL=http://localhost:3333

# API key for Scraper → events HTTP endpoint (POST /events/notify)
# Must match SCRAPER_API_KEY in ProStaff-Scraper
SCRAPER_API_KEY=

# Phoenix host for URL generation
PHX_HOST=localhost
